{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016KjUYreaasfcsshyyq5VLQ","type":"tool_result","content":"60\t\n61\t/// Stub the filesystem for native tests\n62\t#ifndef EMSCRIPTEN\n63\t/// This is only used for tests.\n64\tstatic std::unique_ptr<duckdb::FileSystem> NATIVE_FS = duckdb::FileSystem::CreateLocal();\n65\t/// Get or open a file and throw if something is off\n66\tstatic duckdb::FileHandle &GetOrOpen(size_t file_id) {\n67\t    auto file = WebFileSystem::Get()->GetFile(file_id);\n68\t    if (!file) {\n69\t        throw std::runtime_error(\"unknown file\");\n70\t    }\n71\t    auto &infos = GetLocalState();\n72\t    switch (file->GetDataProtocol()) {\n73\t        case WebFileSystem::DataProtocol::BROWSER_FSACCESS:\n74\t        case WebFileSystem::DataProtocol::BROWSER_FILEREADER:\n75\t        case WebFileSystem::DataProtocol::NODE_FS: {\n76\t            assert(file->GetDataURL());\n77\t            if (auto iter = infos.handles.find(file_id); iter != infos.handles.end()) {\n78\t                return *iter->second;\n79\t            }\n80\t            auto [it, ok] = infos.handles.insert(\n81\t                {file_id, NATIVE_FS->OpenFile(*file->GetDataURL(), duckdb::FileFlags::FILE_FLAGS_FILE_CREATE |\n82\t                                                                       duckdb::FileFlags::FILE_FLAGS_READ |\n83\t                                                                       duckdb::FileFlags::FILE_FLAGS_WRITE)});\n84\t            return *it->second;\n85\t        }\n86\t        case WebFileSystem::DataProtocol::BUFFER:\n87\t        case WebFileSystem::DataProtocol::HTTP:\n88\t        case WebFileSystem::DataProtocol::S3:\n89\t            throw std::logic_error(\"data protocol not supported by fake webfs runtime\");\n90\t    }\n91\t    throw std::logic_error(\"unknown data protocol\");\n92\t}\n93\t#endif\n94\t\n95\tstruct OpenedFile {\n96\t    /// The file size\n97\t    double file_size;\n98\t    /// The file buffer\n99\t    double file_buffer;\n100\t    /// The file time_t\n101\t    double file_last_modification;\n102\t};\n103\t\n104\t#ifdef EMSCRIPTEN\n105\t#define RT_FN(FUNC, IMPL) extern \"C\" FUNC;\n106\t#else\n107\t#define RT_FN(FUNC, IMPL) FUNC IMPL;\n108\t#endif\n109\tRT_FN(uint32_t duckdb_web_fs_get_default_data_protocol(), { return io::WebFileSystem::DataProtocol::NODE_FS; });"}]},"parent_tool_use_id":null,"session_id":"3c4350dd-ce4a-4df6-94b3-4f1719fce8fc","uuid":"655db2e2-1c9a-4aec-9e70-26dac7a6abd7","timestamp":"2026-06-08T14:46:38.668Z","tool_use_result":{"type":"text","file":{"filePath":"duckdb-wasm/lib/src/io/web_filesystem.cc","content":"\n/// Stub the filesystem for native tests\n#ifndef EMSCRIPTEN\n/// This is only used for tests.\nstatic std::unique_ptr<duckdb::FileSystem> NATIVE_FS = duckdb::FileSystem::CreateLocal();\n/// Get or open a file and throw if something is off\nstatic duckdb::FileHandle &GetOrOpen(size_t file_id) {\n    auto file = WebFileSystem::Get()->GetFile(file_id);\n    if (!file) {\n        throw std::runtime_error(\"unknown file\");\n    }\n    auto &infos = GetLocalState();\n    switch (file->GetDataProtocol()) {\n        case WebFileSystem::DataProtocol::BROWSER_FSACCESS:\n        case WebFileSystem::DataProtocol::BROWSER_FILEREADER:\n        case WebFileSystem::DataProtocol::NODE_FS: {\n            assert(file->GetDataURL());\n            if (auto iter = infos.handles.find(file_id); iter != infos.handles.end()) {\n                return *iter->second;\n            }\n            auto [it, ok] = infos.handles.insert(\n                {file_id, NATIVE_FS->OpenFile(*file->GetDataURL(), duckdb::FileFlags::FILE_FLAGS_FILE_CREATE |\n                                                                       duckdb::FileFlags::FILE_FLAGS_READ |\n                                                                       duckdb::FileFlags::FILE_FLAGS_WRITE)});\n            return *it->second;\n        }\n        case WebFileSystem::DataProtocol::BUFFER:\n        case WebFileSystem::DataProtocol::HTTP:\n        case WebFileSystem::DataProtocol::S3:\n            throw std::logic_error(\"data protocol not supported by fake webfs runtime\");\n    }\n    throw std::logic_error(\"unknown data protocol\");\n}\n#endif\n\nstruct OpenedFile {\n    /// The file size\n    double file_size;\n    /// The file buffer\n    double file_buffer;\n    /// The file time_t\n    double file_last_modification;\n};\n\n#ifdef EMSCRIPTEN\n#define RT_FN(FUNC, IMPL) extern \"C\" FUNC;\n#else\n#define RT_FN(FUNC, IMPL) FUNC IMPL;\n#endif\nRT_FN(uint32_t duckdb_web_fs_get_default_data_protocol(), { return io::WebFileSystem::DataProtocol::NODE_FS; });","numLines":50,"startLine":60,"totalLines":1100}}}
